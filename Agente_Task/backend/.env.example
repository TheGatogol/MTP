# ─── Firebase ─────────────────────────────────────────────
# Project ID (Firebase console → Configuración del proyecto → General)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Ruta ABSOLUTA al JSON de la cuenta de servicio. Guárdalo FUERA del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\qa-task-agent-sa.json

# ─── IA local ─────────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=30m
# Ventana de contexto. 8192 es suficiente y cabe junto con qwen3:14b en 12 GB de VRAM.
OLLAMA_NUM_CTX=8192

# ─── Aplicación ───────────────────────────────────────────
APP_TIMEZONE=America/Mexico_City
# Nombre de la persona que usa la app (filtro "Mis actividades")
CURRENT_USER_NAME=Rodrigo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8000
