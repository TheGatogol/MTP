rules_version = '2';

// QA Task Agent: el frontend NUNCA accede a Firestore directamente.
// Todo pasa por el backend (FastAPI) con el Admin SDK, que no está sujeto a estas reglas.
// Por eso se deniega cualquier acceso desde clientes (web, móviles, SDKs cliente).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
