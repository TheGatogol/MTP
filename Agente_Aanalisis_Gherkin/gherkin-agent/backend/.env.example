# Rutas (relativas a la carpeta backend/ o absolutas). Por defecto apuntan a las carpetas hermanas
# de gherkin-agent/: ../framework/glomo-mx y ../MetricasCodigo.
# FRAMEWORK_DIR=../../framework/glomo-mx
# METRICS_DIR=../../MetricasCodigo
# DATA_DIR=../data

# IA local (Ollama)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
