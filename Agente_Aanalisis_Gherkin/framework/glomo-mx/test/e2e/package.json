{
    "name": "glomo_html-test-e2e",
    "version": "1.0.0",
    "description": "End2End tests for GloMo MX",
    "scripts": {
        "postinstall": "run-script-os",
        "postinstall:windows": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command .\\postinstall.ps1",
        "postinstall:default": "./postinstall.sh || echo 'Post install failed. Skipping'",
        "postinstall:macos": "run-s :ios:appium:workaround postinstall:default",
        "lint-ci": "run-s -c -n lint",
        "lint": "run-s -c -n lint:es lint:gherkin",
        "lint:es": "eslint --max-warnings 0 lib/",
        "lint:gherkin": "gplint -c node_modules/@csqe/gplintrules/.gplintrc_MX -r node_modules/@csqe/gplintrules/rulesdir --max-warnings 2 lib/features",
        "lint:vbank": "vbank-lint --max-warnings 0 vbank",
        "lint:fix": "eslint --max-warnings 0 lib/ --fix",
        "test:e2e": "radish",
        "cucumber:list": "cucumber-scenarios-list",
        "templates": "run-s templates:init templates:update",
        "templates:init": "git submodule init",
        "templates:update": "git submodule update",
        "templates:upgrade": "git submodule update --remote --merge",
        ":ios:appium:workaround": "pnpm add -D appium-webdriveragent@4.13.1 && rm -rf ./node_modules/*/**/appium-webdriveragent && git checkout package.json"
    },
    "author": "GloMo QA Team",
    "license": "ISC",
    "dependencies": {
        "@babel/cli": "7.24.7",
        "@babel/core": "7.24.7",
        "@babel/eslint-parser": "7.24.7",
        "@babel/plugin-proposal-decorators": "7.24.7",
        "@babel/preset-env": "7.24.7",
        "@babel/register": "7.24.6",
        "@csqe/cucumber-scenarios-list": "1.0.0",
        "@csqe/radish": "7.5.1",
        "@csqe/vbank-lint": "0.1.0",
        "@cucumber/cucumber": "^11.2.0",
        "@testing/vbank-js-launcher": "0.85.0",
        "babel-plugin-module-resolver": "4.1.0",
        "npm-run-all": "4.1.5",
        "requireindex": "1.2.0",
        "run-script-os": "1.1.6"
    },
    "devDependencies": {
        "eslint": "8.43.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-promise": "6.2.0",
        "@csqe/gplintrules": "1.4.0",
        "gplint": "2.5.2",
        "saucelabs": "9.1.0"
    },
    "overrides": {
        "gplint": {
            "glob": "10.3.10"
        }
    },
    "pnpm": {
        "overrides": {
            "gplint>glob": "10.3.10"
        }
    }
}
